{
	"name": "titanworks/titanworks-bazna-cijena",
	"description": "Croatian anchor price (sidrena cijena) and base price (bazna cijena) compliance plugin for WordPress and WooCommerce. Development tooling only; no runtime dependencies.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": "^11.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Titanworks\\SidrenaCijena\\": "src/"
		}
	},
	"scripts": {
		"test:unit": "phpunit --testsuite=unit",
		"test:integration": "phpunit --testsuite=integration",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
