# Exclude development, test, and translation binary/source files from distribution archives.
# WordPress.org manages translations via translate.wordpress.org.
languages/*.po export-ignore
languages/*.mo export-ignore
tests/ export-ignore
tools/ export-ignore
docs/ export-ignore
AGENTARDS/ export-ignore
.github/ export-ignore
.circleci/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
phpunit.xml.dist export-ignore
phpcs.xml.dist export-ignore
phpstan.neon.dist export-ignore
package.json export-ignore
package-lock.json export-ignore
composer.json export-ignore
composer.lock export-ignore
PROMPT.md export-ignore
completion.md export-ignore
