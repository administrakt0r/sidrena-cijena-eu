includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	# Limit worker count so a cache-cold analysis stays within the executor budget.
	parallel:
		maximumNumberOfProcesses: 1
	tmpDir: .phpstan.cache
	paths:
		- src
		- titanworks-bazna-cijena.php
		- uninstall.php
	excludePaths:
		- tests
		- vendor
	bootstrapFiles:
		- tests/unit/wp-stubs.php
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
	reportUnmatchedIgnoredErrors: false
	ignoreErrors:
		-
			# WordPress-style heterogeneous option/argument arrays; their shapes are
			# enforced at runtime (Settings::sanitize, repository normalize(), Validator).
			identifier: missingType.iterableValue
